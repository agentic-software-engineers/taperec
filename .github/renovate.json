{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "separateMinorPatch": true,
  "pinDigests": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": [
      "security"
    ],
    "semanticCommitType": "fix"
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Node, pinned in the workflow that lints commit messages.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/commitlint\\.yaml$/"
      ],
      "matchStrings": [
        "node-version: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "description": "Track tool images pinned as name:tag@digest in scripts, hooks and workflows.",
      "managerFilePatterns": [
        "/^lint\\.sh$/",
        "/^\\.pre-commit-config\\.yaml$/",
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9./-]*):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the pre-commit version CI runs.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "pre-commit==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pre-commit"
    }
  ],
  "packageRules": [
    {
      "description": "Except the pipeline, which no user ever runs.",
      "matchFileNames": [
        ".github/**"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "Bundle the digest refreshes that ship, which carry no version to review.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "digests"
    },
    {
      "description": "The same for the pipeline, kept apart so each group carries one commit type.",
      "matchFileNames": [
        ".github/**"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "workflow digests"
    },
    {
      "description": "A digest names a build, not a release, so it has no date an age check could measure.",
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Label major updates so they get a deliberate review.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "breaking"
      ]
    },
    {
      "description": "Move the toolchain pin and its build image together, since they change what is built.",
      "matchDepNames": [
        "rust"
      ],
      "groupName": "Rust toolchain"
    },
    {
      "description": "Renovate updates itself through the renovate-version line, which the github-actions manager reads as an image but which takes no digest.",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "pinDigests": false
    }
  ]
}
